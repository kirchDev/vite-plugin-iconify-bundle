{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "vite-plugin-iconify-bundle",
  "version": "0.0.0",
  "description": "Vite plugin that bundles only the Iconify icons your source actually uses — no runtime API calls, no whole collections.",
  "keywords": [
    "bundle",
    "iconify",
    "icons",
    "kirchdev",
    "ssr",
    "tree-shaking",
    "virtual-module",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/kirchDev/vite-plugin-iconify-bundle#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/vite-plugin-iconify-bundle/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/vite-plugin-iconify-bundle.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.js",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "taze": "^19.16.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.2.2"
}

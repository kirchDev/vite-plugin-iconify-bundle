{
  "$schema": "https://raw.githubusercontent.com/TitusKirch/skills/main/tituskirch-skills.schema.json",
  "language": "en",
  "verify": "pnpm check",
  "trustedBots": [
    {
      "id": 287319172,
      "login": "kirchdev-release[bot]"
    },
    {
      "id": 49699333,
      "login": "dependabot[bot]"
    }
  ],
  "commit": {
    "language": "en"
  },
  "pr": {
    "base": "dev",
    "title": {
      "convention": "conventional"
    }
  },
  "release": {
    "promote": "auto",
    "stages": ["dev", "main"]
  },
  "mergeDeps": {
    "merge": "grouped"
  },
  "issue": {
    "tracker": "github",
    "labels": {
      "exclude": ["stack:*", "autorelease:*", "dependencies"]
    }
  },
  "docs": {
    "preset": "package",
    "render": "duxt"
  },
  "work": {
    "tracker": "github",
    "branch": "branch:dev",
    "labels": {
      "ready": "ai: ready",
      "working": "ai: working",
      "reviewRequested": "ai: review requested",
      "reviewing": "ai: reviewing",
      "changesRequested": "ai: changes requested",
      "needsHuman": "ai: needs human",
      "done": "ai: done",
      "blocked": "ai: blocked",
      "repo": false,
      "needsTriage": "needs triage"
    },
    "review": {
      "maxRounds": 3
    },
    "priorityLabels": [
      "priority: urgent",
      "priority: high",
      "priority: medium",
      "priority: low"
    ]
  },
  "profiles": {
    "parallel": {
      "work": {
        "parallel": true,
        "concurrency": 4
      }
    },
    "parallel-worktree": {
      "work": {
        "concurrency": 8,
        "branch": "worktree",
        "parallel": true
      }
    },
    "parallel-worktree-queue": {
      "work": {
        "concurrency": 8,
        "branch": "worktree",
        "parallel": true,
        "queueBranch": true
      }
    }
  }
}
